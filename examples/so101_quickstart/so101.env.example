# SO-101 quickstart config. Copy to so101.env and edit, then run ./so101.sh <step>.
# Every value can also be overridden from the shell, e.g. `TASK_NAME=cube2 ./so101.sh record`.

# Robot type pair. For SO-100 use so100_follower / so100_leader.
ROBOT_TYPE=so101_follower
TELEOP_TYPE=so101_leader

# Serial ports (find them with `./so101.sh find-port`). On Linux the first arm plugged in is
# usually /dev/ttyACM0 and the second /dev/ttyACM1. Run `./so101.sh perms` if access is denied.
FOLLOWER_PORT=/dev/ttyACM0
LEADER_PORT=/dev/ttyACM1

# Calibration ids: keep them stable, they are the calibration file names.
FOLLOWER_ID=my_follower
LEADER_ID=my_leader

# Cameras (find indices with `./so101.sh find-cameras`). One fixed front + one wrist is recommended.
CAMERAS="{ front: {type: opencv, index_or_path: 0, width: 640, height: 480, fps: 30, fourcc: \"MJPG\"}}"
# CAMERAS="{ front: {type: opencv, index_or_path: 0, width: 640, height: 480, fps: 30, fourcc: \"MJPG\"}, wrist: {type: opencv, index_or_path: 2, width: 640, height: 480, fps: 30, fourcc: \"MJPG\"}}"

# Dataset. HF_USER defaults to the logged-in `hf auth whoami` user.
# HF_USER=your_hf_name
TASK_NAME=pick_cube
TASK_DESC="Pick up the cube and place it in the box"
NUM_EPISODES=50
EPISODE_TIME_S=30
RESET_TIME_S=10
PUSH_TO_HUB=true       # false = keep the dataset local under ~/.cache/huggingface/lerobot

# Training.
# act = fast, small GPU. flux3 = FLUX 3 Action (7B world action model) LoRA fine-tune of the SO-101
# checkpoint; needs `uv sync --extra flux3` plus a torch-matched NATTEN wheel and a large GPU, and
# expects two cameras named `scene` and `wrist` (or set RENAME_MAP).
POLICY_TYPE=act
DEVICE=cuda            # cuda | mps (Apple silicon) | cpu
BATCH_SIZE=8
STEPS=50000
WANDB=false

# FLUX 3 only.
# FLUX3_BASE=black-forest-labs/flux-3-action-so101
# RENAME_MAP='{"observation.images.front":"observation.images.scene"}'

# Evaluation.
EVAL_EPISODES=10
